# Every variable qone-front reads (norm 5.1). Copy to .env and fill the placeholders; .env is ignored.
# Origin of qone-api-gateway, the only piece the browser talks to. Portals never read it.
VITE_GATEWAY_URL=http://localhost:8080
# Development sign-in with a token from qone-infra/scripts/dev-token.sh (norm 5.5.2). Never true on main.
VITE_DEV_LOGIN=true
# Serve synthetic data with MSW instead of the gateway (ADR-009). Fixtures mirror the 06-data seeds.
VITE_USE_MOCKS=false
# remoteEntry.js of each domain portal (Annex H). Empty = that portal is not deployed in this environment.
VITE_REMOTE_IDENTITY_URL=http://localhost:5001/remoteEntry.js
VITE_REMOTE_CATALOG_URL=http://localhost:5002/remoteEntry.js
VITE_REMOTE_ENROLLMENT_URL=http://localhost:5003/remoteEntry.js
VITE_REMOTE_BILLING_URL=http://localhost:5004/remoteEntry.js
VITE_REMOTE_ADVISOR_URL=http://localhost:5005/remoteEntry.js
